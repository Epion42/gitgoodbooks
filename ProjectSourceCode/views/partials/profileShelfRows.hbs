{{#each books }}
  <div class="list-group-item d-flex align-items-center gap-3">
    <a href="/books/{{bookId}}"
       class="d-flex align-items-center gap-3 flex-grow-1 text-reset text-decoration-none">
      {{#if thumbnail }}
        <img src="{{thumbnail}}" alt="Cover of {{title}}" class="profile-cover-sm" />
      {{else}}
        <img src="/resources/img/mock%20book%20cover.png"
             alt="No cover available for {{title}}"
             class="profile-cover-sm" />
      {{/if}}
      <div class="flex-grow-1">
        <h3 class="h6 mb-1">{{title}}</h3>
        <p class="mb-0 text-muted small">
          {{#if authors }}
            {{#each authors }}
              {{this}}{{#unless @last}}, {{/unless}}
            {{/each}}
          {{else}}
            Unknown author
          {{/if}}
        </p>
      </div>
      {{#if stars }}
        <span class="text-warning text-nowrap" title="{{rating}} out of 5">{{stars}}</span>
      {{/if}}
    </a>
    <form method="post"
          action="/journal/{{bookId}}/remove"
          data-confirm="Remove &quot;{{title}}&quot; from your journal? This will also delete any notes.">
      <input type="hidden" name="returnTo" value="profile" />
      <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">Remove</button>
    </form>
  </div>
{{/each }}
