<div class="list-group">
  {{#each books }}
    <a href="/books/{{bookId}}"
       class="list-group-item list-group-item-action d-flex gap-3">
      {{#if thumbnail }}
        <img src="{{thumbnail}}" alt="" width="60" />
      {{/if}}
      <div>
        <h5 class="mb-1">{{title}}</h5>
        <p class="mb-0 text-muted">
          {{#each authors }}
            {{this}}{{#unless @last}},{{/unless}}
          {{/each}}
          {{#if publishYear }}
            · {{publishYear}}
          {{/if}}
        </p>
      </div>
    </a>
  {{else}}
    <p>No books found.</p>
  {{/each}}
</div>
