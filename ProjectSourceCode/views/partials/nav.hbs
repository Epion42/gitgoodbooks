<div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5">Logout</h1>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"></button>
      </div>
      <div class="modal-body">Are you sure you want to logout?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <form method="post" action="/logout">
          <button type="submit" class="btn btn-danger">Logout</button>
        </form>
      </div>
    </div>
  </div>
</div>

<header>
  <nav class="navbar navbar-expand-sm border-bottom">
    <div class="container-fluid">
      <a class="navbar-brand" href="/home">GitGoodBooks</a>

      <form class="d-flex flex-grow-1 mx-sm-3 my-2 my-sm-0"
            role="search"
            action="/search"
            method="get">
        <label for="navSearch" class="visually-hidden">Search books</label>
        <input class="form-control me-2"
               id="navSearch"
               type="search"
               placeholder="Search"
               name="q">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
      </form>

      <ul class="navbar-nav align-items-center ms-auto mb-2 mb-sm-0">
        {{#if currentUser }}
          <li class="nav-item me-sm-3">
            <a class="nav-link" href="/profile">{{currentUser.username}}</a>
          </li>
          <li class="nav-item">
            <button type="button"
                    class="btn btn-outline-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#logoutModal">Logout</button>
          </li>
        {{else}}
          <li class="nav-item me-2">
            <a class="btn btn-outline-primary" href="/register">Register</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-outline-primary" href="/login">Login</a>
          </li>
        {{/if}}
      </ul>
    </div>
  </nav>
</header>
