<!-- Need to change the nav to fit in a search bar, login/logout options, and logo -->
<header>
 <nav class="navbar navbar-expand-sm border-bottom">
   <div class="container-fluid">
    <a class="navbar-brand" href="#">
        <img src="#" alt="GitGoodBooks" width="24" height="24" class="d-inline-block align-text-top">
    </a>

    <form class="container-md d-flex" action="/search" method="POST">
        <input class="form-control me-2" placeholder="Search" name="search">
        <button class="btn btn-outline-secondary" type="submit"><img src="#" alt="Search" width="16" height="16"></button>
    </form>

    <ul class="navbar-nav me-auto mb-2 ">
        {{#if currentUser}}
        <li class="nav-item me-sm-3"> <span class="navbar-text">{{currentUser.username}}</span> </li>
        <li class="nav-item"><form method="POST" action="/logout"><button type="submit" class="nav-link">Logout</button></form></li>
        {{else}}
        <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
        {{/if}}
    </ul>
</header>
