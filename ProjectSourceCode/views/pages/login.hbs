<!-- Login Page Template -->
<link rel="stylesheet" href="../../resources/css/login.css"> <!--added stylesheet-->
<h1 class="mb-4">Login</h1> <!--changed spelling-->
{{#if error }}
  <div class="alert alert-danger" role="alert">{{error}}</div>
{{/if}}
<div class="login-container"> <!--added div-container-->
   <div class="login-image"> <!--added image div-->
       <img src="../../resources/img/gitgoodbookslogin.png" alt="login page image">
   </div>
  <form method="post" action="/login" class="col-12 col-md-6 col-lg-4">
    <div class="mb-3">
      <label for="username" class="form-label">Username</label>
      <input type="text"
             class="form-control"
             id="username"
             name="username"
             maxlength="32"
             autocomplete="username"
             required />
    </div>
    <div class="mb-3">
      <label for="password" class="form-label">Password</label>
      <input type="password"
             class="form-control"
             id="password"
             name="password"
             autocomplete="current-password"
             required />
    </div>
    <p class="mt-3">No Account? <a href="/register">Register</a></p><!--added registration option-->
    <button type="submit" class="btn btn-primary">Login</button> <!--edited spelling-->
  </form>
 </div>
