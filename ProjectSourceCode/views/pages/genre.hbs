{{! Genre Page Template }}
<div class="row">
  {{> sidebar}}
  <div class="col">
    <div class="container py-4">
      <a href="/browse" class="d-inline-block mb-2">← All genres</a>
      <h1 class="mb-4">{{genre.name}}</h1>
      {{> bookList }}
      {{#if totalPages }}
        <nav class="d-flex justify-content-center align-items-center gap-3 mt-4">
          {{#if prevPage }}
            <a class="btn btn-primary" href="?page={{prevPage}}">Previous</a>
          {{/if}}
          <span class="text-muted">Page {{page}} of {{totalPages}}</span>
          {{#if nextPage }}
            <a class="btn btn-primary" href="?page={{nextPage}}">Next</a>
          {{/if}}
        </nav>
      {{/if}}
    </div>
  </div>
</div>
