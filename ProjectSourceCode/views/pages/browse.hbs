<!-- Browse Page Template -->
<h1 class="mb-4">Browse</h1>
<div class="row g-3">
  {{#each genres }}
    <div class="col-6 col-md-4 col-lg-3">
      <a href="/browse/{{slug}}" class="card h-100 text-decoration-none">
        <div class="card-body">
          <h5 class="card-title">{{name}}</h5>
          <p class="card-text text-muted">{{bookCount}} books</p>
        </div>
      </a>
    </div>
  {{/each}}
</div>
