<!-- Profile Page Template -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <h1 class="mb-0">{{profileUser.username}}</h1>
  {{#if isOwner }}
    <a class="btn btn-outline-primary" href="/profile/edit">Edit profile</a>
  {{/if }}
</div>

{{#if updated }}
  <div class="alert alert-success" role="alert">Profile updated.</div>
{{/if }}

<section class="mb-5">
  <h2 class="h4 mb-3">Books to read</h2>
  {{#if toRead.length }}
    <div class="profile-carousel">
      <button type="button"
              class="profile-carousel-btn"
              data-carousel-prev
              aria-label="Show previous books">
        <span aria-hidden="true">‹</span>
      </button>
      <div class="profile-carousel-track" data-carousel-track>
        {{#each toRead }}
          <div class="profile-carousel-item">{{> profileBookCard isOwner=../isOwner }}</div>
        {{/each }}
      </div>
      <button type="button"
              class="profile-carousel-btn"
              data-carousel-next
              aria-label="Show next books">
        <span aria-hidden="true">›</span>
      </button>
    </div>
    <button type="button"
            class="btn btn-link px-0 mt-2"
            data-bs-toggle="modal"
            data-bs-target="#toReadModal">Show all books ({{toRead.length}})</button>
  {{else}}
    <p class="text-muted mb-0">No books on the to-read list yet.</p>
  {{/if }}
</section>

{{> profileShelf title="Books in progress" shelf=inProgress emptyMessage="Not reading any books right now." isOwner=isOwner }}

{{> profileShelf title="Books completed" shelf=completed emptyMessage="No completed books yet." isOwner=isOwner }}

{{> profileShelf title="Books that were not finished" shelf=didNotFinish emptyMessage="No books marked as not finished." isOwner=isOwner }}

{{#if toRead.length }}
  {{> profileToReadModal isOwner=isOwner }}
{{/if }}
