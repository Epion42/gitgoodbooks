{{! Profile Page Template }}
<div class="container py-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <h1 class="mb-1">{{profileUser.username}}</h1>
      <p class="text-muted mb-0">
        <a class="link-secondary text-decoration-none"
           href="/profile/{{profileUser.username}}/followers">{{profileUser.followerCount}} followers</a>
        <span aria-hidden="true">·</span>
        <a class="link-secondary text-decoration-none"
           href="/profile/{{profileUser.username}}/followers?tab=following">{{profileUser.followingCount}} following</a>
      </p>
    </div>
    <div class="d-flex gap-2">
      {{#if isOwner }}
        <a class="btn btn-primary" href="/profile/edit">Edit profile</a>
        <a class="btn btn-primary" href="/profile/taste">Taste profile</a>
      {{else}}
        {{#if currentUser }}
          <form method="post"
                action="/profile/{{profileUser.username}}/{{followAction}}">
            <input type="hidden"
                   name="returnTo"
                   value="/profile/{{profileUser.username}}" />
            {{#if isFollowing }}
              <button type="submit" class="btn btn-secondary">Unfollow</button>
            {{else}}
              <button type="submit" class="btn btn-primary">Follow</button>
            {{/if }}
          </form>
        {{/if }}
      {{/if }}
    </div>
  </div>

  {{#if updated }}
    <div class="alert alert-success" role="alert">Profile updated.</div>
  {{/if }}

  <section class="mb-5">
    <h2 class="h4 mb-3">Books to read</h2>
    {{#if toRead.length }}
      <div class="profile-carousel">
        <button type="button"
                class="profile-carousel-btn"
                data-carousel-prev
                aria-label="Show previous books">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="profile-carousel-track" data-carousel-track>
          {{#each toRead }}
            <div class="profile-carousel-item">{{> profileBookCard isOwner=../isOwner }}</div>
          {{/each }}
        </div>
        <button type="button"
                class="profile-carousel-btn"
                data-carousel-next
                aria-label="Show next books">
          <span aria-hidden="true">›</span>
        </button>
      </div>
      <button type="button"
              class="btn btn-link px-0 mt-2"
              data-bs-toggle="modal"
              data-bs-target="#toReadModal">Show all books ({{toRead.length}})</button>
    {{else}}
      <p class="text-muted mb-0">No books on the to-read list yet.</p>
    {{/if }}
  </section>

  {{> profileShelf title="Books in progress" shelf=inProgress emptyMessage="Not reading any books right now." isOwner=isOwner }}

  {{> profileShelf title="Books completed" shelf=completed emptyMessage="No completed books yet." isOwner=isOwner }}

  {{> profileShelf title="Books that were not finished" shelf=didNotFinish emptyMessage="No books marked as not finished." isOwner=isOwner }}

  {{#if toRead.length }}
    {{> profileToReadModal isOwner=isOwner }}
  {{/if }}
</div>
